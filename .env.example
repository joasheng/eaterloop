# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Resend sends scheduled member notifications.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=Eaterloop <letters@example.com>

# "log" prints intended emails locally. Use "send" after Resend is configured.
EMAIL_MODE=log

# Protects /api/cron/monthly in production.
CRON_SECRET=replace-with-a-long-random-value

# One-time bootstrap values.
GROUP_NAME=EATING
GROUP_TIMEZONE=America/Los_Angeles
MEMBER_EMAILS=friend1@example.com,friend2@example.com,friend3@example.com,friend4@example.com,friend5@example.com
MEMBER_NAMES=Friend One,Friend Two,Friend Three,Friend Four,Friend Five
